# Not required to run Phase 1 (the scroll experience, catalog, filament
# switcher, and upload-estimate flow are fully client-side / static).
# These become relevant in Phase 2 when checkout and real order storage
# are added.

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Server-side Basic Auth in front of /admin (see src/middleware.ts).
# Set these on your host before deploying publicly — without them, /admin
# is only protected by the client-side login, which is not real security.
ADMIN_BASIC_AUTH_USER=""
ADMIN_BASIC_AUTH_PASSWORD=""
